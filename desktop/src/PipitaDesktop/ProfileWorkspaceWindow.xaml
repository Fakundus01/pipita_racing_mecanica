<Window x:Class="PipitaDesktop.ProfileWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perfil y sincronizacion"
        Height="780"
        Width="1320"
        MinHeight="720"
        MinWidth="1180"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="#EEF4FC" />
            <Setter Property="BorderBrush" Value="#C9D9EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,6,0,12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#C9D9EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,6,0,12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#C9D9EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,6,0,12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#C9D9EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#165BB5" CornerRadius="18" Padding="22,18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Perfiles, seguridad y sync" FontSize="28" FontWeight="Bold" Foreground="White" />
                    <TextBlock Margin="0,6,0,0" Text="Cada perfil usa su propia base local. El sync remoto es opcional y trabaja por snapshot." Foreground="#E7F3FF" />
                    <WrapPanel Margin="0,12,0,0">
                        <Border Background="#22FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14" Padding="10,5" Margin="0,0,8,0">
                            <TextBlock x:Name="CurrentProfileHeaderText" Foreground="White" Text="Perfil actual" />
                        </Border>
                        <Border Background="#22FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14" Padding="10,5">
                            <TextBlock x:Name="CurrentRemoteHeaderText" Foreground="White" Text="Sync remoto no configurado" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="Cerrar" MinWidth="120" Click="CerrarButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D6E1EF" BorderThickness="1" CornerRadius="16" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Perfiles locales" FontSize="22" FontWeight="Bold" Foreground="#1C3552" />
                        <TextBlock Margin="0,6,0,0" Text="Cambia entre talleres o responsables sin mezclar datos." Foreground="#5C7287" TextWrapping="Wrap" />
                    </StackPanel>

                    <ListBox x:Name="ProfilesListBox" Grid.Row="1" Margin="0,16,0,16" SelectionChanged="ProfilesListBox_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemRoot" Background="#F8FBFF" BorderBrush="#D7E3F0" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemRoot" Property="Background" Value="#DDEBFE" />
                                                    <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#8AB5EA" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemRoot" Property="Background" Value="#EEF5FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding Name}" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#5C7287" Text="{Binding Slug}" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#34597E" Text="{Binding RemoteAccountEmail, TargetNullValue=Sin cuenta remota vinculada}" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#5C7287">
                                        <Run Text="PIN: " />
                                        <Run Text="{Binding HasPin, StringFormat={}{0}}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Nombre del perfil" FontWeight="SemiBold" />
                        <TextBox x:Name="ProfileNameInput" />
                        <TextBlock Text="PIN del perfil" FontWeight="SemiBold" />
                        <PasswordBox x:Name="ProfilePinInput" />
                        <WrapPanel>
                            <Button Content="Crear" MinWidth="92" Click="CrearPerfilButton_Click" />
                            <Button Content="Renombrar" MinWidth="108" Click="RenombrarPerfilButton_Click" />
                            <Button Content="Eliminar" MinWidth="92" Click="EliminarPerfilButton_Click" />
                            <Button Content="Cambiar perfil" MinWidth="130" Click="CambiarPerfilButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D6E1EF" BorderThickness="1" CornerRadius="16" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Perfil seleccionado" FontSize="22" FontWeight="Bold" Foreground="#1C3552" />
                        <TextBlock x:Name="SelectedProfileSummaryText" Margin="0,8,0,0" Foreground="#5C7287" TextWrapping="Wrap" />

                        <Border Margin="0,16,0,0" Background="#F8FBFF" BorderBrush="#D9E3F0" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Rutas locales" FontSize="18" FontWeight="SemiBold" Foreground="#1C3552" />
                                <TextBlock Margin="0,12,0,0" Text="Carpeta del perfil" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProfileFolderText" Margin="0,4,0,0" Foreground="#5C7287" TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0" Text="Base de datos" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProfileDatabaseText" Margin="0,4,0,0" Foreground="#5C7287" TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0" Text="Backups" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProfileBackupsText" Margin="0,4,0,0" Foreground="#5C7287" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Abrir carpeta" MinWidth="120" Click="AbrirCarpetaPerfilButton_Click" />
                                    <Button Content="Abrir backups" MinWidth="120" Click="AbrirCarpetaBackupsButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Background="#F8FBFF" BorderBrush="#D9E3F0" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Seguridad y respaldo" FontSize="18" FontWeight="SemiBold" Foreground="#1C3552" />
                                <TextBlock Margin="0,12,0,0" Text="Estado del PIN" FontWeight="SemiBold" />
                                <TextBlock x:Name="PinStatusText" Margin="0,4,0,0" Foreground="#5C7287" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Guardar PIN" MinWidth="110" Click="GuardarPinButton_Click" />
                                    <Button Content="Quitar PIN" MinWidth="110" Click="QuitarPinButton_Click" />
                                </WrapPanel>
                                <TextBlock Margin="0,18,0,0" Text="Respaldo local" FontWeight="SemiBold" />
                                <TextBlock x:Name="LocalSnapshotText" Margin="0,4,0,0" Foreground="#5C7287" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Crear backup" MinWidth="120" Click="CrearBackupButton_Click" />
                                    <Button Content="Restaurar backup" MinWidth="130" Click="RestaurarBackupButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="4" Background="White" BorderBrush="#D6E1EF" BorderThickness="1" CornerRadius="16" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Cuenta remota y sync" FontSize="22" FontWeight="Bold" Foreground="#1C3552" />
                        <TextBlock Margin="0,8,0,0" Text="Usa el backend de sync para guardar un snapshot del perfil y recuperarlo en otra PC." Foreground="#5C7287" TextWrapping="Wrap" />

                        <TextBlock Margin="0,16,0,0" Text="URL de la API" FontWeight="SemiBold" />
                        <TextBox x:Name="ApiBaseUrlInput" />
                        <WrapPanel>
                            <Button Content="Guardar URL" MinWidth="110" Click="GuardarApiUrlButton_Click" />
                            <Button Content="Probar conexion" MinWidth="128" Click="ProbarConexionButton_Click" />
                        </WrapPanel>

                        <Border Margin="0,16,0,0" Background="#F8FBFF" BorderBrush="#D9E3F0" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Sesion remota" FontSize="18" FontWeight="SemiBold" Foreground="#1C3552" />
                                <TextBlock x:Name="RemoteSessionText" Margin="0,8,0,0" Foreground="#5C7287" TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0" Text="Email" FontWeight="SemiBold" />
                                <TextBox x:Name="RemoteEmailInput" />
                                <TextBlock Text="Password" FontWeight="SemiBold" />
                                <PasswordBox x:Name="RemotePasswordInput" />
                                <WrapPanel>
                                    <Button Content="Registrarse" MinWidth="108" Click="RegistrarCuentaButton_Click" />
                                    <Button Content="Ingresar" MinWidth="96" Click="IngresarCuentaButton_Click" />
                                    <Button Content="Cerrar sesion" MinWidth="120" Click="CerrarSesionRemotaButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Background="#F8FBFF" BorderBrush="#D9E3F0" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Perfil remoto" FontSize="18" FontWeight="SemiBold" Foreground="#1C3552" />
                                <TextBlock x:Name="LinkedRemoteText" Margin="0,8,0,0" Foreground="#5C7287" TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0" Text="Perfiles remotos" FontWeight="SemiBold" />
                                <ComboBox x:Name="RemoteProfilesCombo" DisplayMemberPath="Name" SelectionChanged="RemoteProfilesCombo_SelectionChanged" />
                                <TextBlock Text="Nombre para crear remoto" FontWeight="SemiBold" />
                                <TextBox x:Name="RemoteProfileNameInput" />
                                <WrapPanel>
                                    <Button Content="Actualizar remotos" MinWidth="132" Click="ActualizarPerfilesRemotosButton_Click" />
                                    <Button Content="Crear remoto" MinWidth="110" Click="CrearPerfilRemotoButton_Click" />
                                    <Button Content="Vincular" MinWidth="90" Click="VincularPerfilRemotoButton_Click" />
                                    <Button Content="Desvincular" MinWidth="100" Click="DesvincularPerfilRemotoButton_Click" />
                                </WrapPanel>
                                <TextBlock Margin="0,16,0,0" Text="Estado remoto" FontWeight="SemiBold" />
                                <TextBlock x:Name="RemoteSnapshotText" Margin="0,4,0,0" Foreground="#5C7287" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Subir snapshot" MinWidth="122" Click="SubirSnapshotButton_Click" />
                                    <Button Content="Descargar snapshot" MinWidth="142" Click="DescargarSnapshotButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D6E1EF" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="#274B71" Text="Listo." />
        </Border>
    </Grid>
</Window>
