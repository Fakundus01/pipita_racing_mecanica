                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="4,2,4,10">
                                <WrapPanel DockPanel.Dock="Left">
                                    <Button Content="&lt;" Width="42" Click="AgendaMesAnteriorButton_Click" />
                                    <Button Content="Hoy" Click="AgendaHoyButton_Click" />
                                    <Button Content="&gt;" Width="42" Click="AgendaMesSiguienteButton_Click" />
                                </WrapPanel>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding AgendaMesTitulo}" />
                            </DockPanel>

                            <WrapPanel Grid.Row="1" Margin="4,0,4,8">
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Estado" FontWeight="SemiBold" />
                                <ComboBox x:Name="AgendaFiltroEstadoCombo" Width="170" ItemsSource="{Binding EstadoCitasConTodos}" SelectionChanged="AgendaFiltroEstadoCombo_SelectionChanged" />
                            </WrapPanel>

                            <UniformGrid Grid.Row="2" Columns="7" Margin="4,0,4,6">
                                <Border Background="#EEF4FD" Padding="6"><TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Lun" /></Border>
                                <Border Background="#EEF4FD" Padding="6"><TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Mar" /></Border>
                                <Border Background="#EEF4FD" Padding="6"><TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Mie" /></Border>
                                <Border Background="#EEF4FD" Padding="6"><TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Jue" /></Border>
                                <Border Background="#EEF4FD" Padding="6"><TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Vie" /></Border>
                                <Border Background="#EEF4FD" Padding="6"><TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Sab" /></Border>
                                <Border Background="#EEF4FD" Padding="6"><TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Dom" /></Border>
                            </UniformGrid>

                            <ItemsControl Grid.Row="3" ItemsSource="{Binding AgendaDiasMes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="AgendaDiaButton_Click" Style="{x:Null}" Margin="3" Padding="0" BorderThickness="0" Background="Transparent">
                                        <Border x:Name="DayCellBorder" CornerRadius="8" BorderBrush="#D6E2F2" BorderThickness="1" Background="White" Padding="10" MinHeight="124">
                                            <Grid>
                                                <Border x:Name="DayNumberBadge"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        Background="{Binding DayNumberBackground}">
                                                    <TextBlock x:Name="DayNumberText"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding DayNumberForeground}"
                                                               Text="{Binding DayNumber}" />
                                                </Border>

                                                <Ellipse x:Name="DayEventDot"
                                                         Width="8"
                                                         Height="8"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Bottom"
                                                         Margin="0,0,2,2"
                                                         Fill="{Binding DayNumberBackground}"
                                                         Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasCitas}" Value="True">
                                            <Setter TargetName="DayEventDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                            <Setter TargetName="DayCellBorder" Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="DayCellBorder" Property="BorderBrush" Value="#FF4E8CD5" />
                                            <Setter TargetName="DayCellBorder" Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="DayCellBorder" Property="Background" Value="#FFDDEBFE" />
                                            <Setter TargetName="DayCellBorder" Property="BorderBrush" Value="#FF165BB5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Row="4" Margin="4,10,4,8" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="{Binding AgendaResumenDia}" />

                            <TextBlock Grid.Row="5" Margin="4,0,4,8" Text="Citas del dia" FontSize="16" FontWeight="SemiBold" />

                            <DataGrid Grid.Row="6"
                                      x:Name="CitasDiaGrid"
                                      ItemsSource="{Binding CitasDiaSeleccionado}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="CitasDiaGrid_SelectionChanged"
                                      HeadersVisibility="Column"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Inicio" Binding="{Binding FechaHoraInicio, StringFormat={}{0:HH:mm}}" Width="*" />
                                    <DataGridTextColumn Header="Fin" Binding="{Binding FechaHoraFin, StringFormat={}{0:HH:mm}}" Width="*" />
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="2*" />
                                    <DataGridTextColumn Header="Patente" Binding="{Binding Patente}" Width="*" />
                                    <DataGridTemplateColumn Header="Estado" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding EstadoBadgeBackground}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding EstadoBadgeText}" Foreground="{Binding EstadoBadgeForeground}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Grid.Row="7" Margin="4,10,4,8">
                                <TextBlock Text="Vista semanal" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding AgendaSemanaRango}" />
                            </DockPanel>

                            <DataGrid Grid.Row="8"
                                      x:Name="AgendaSemanaGrid"
                                      ItemsSource="{Binding AgendaSemanaSlots}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="*" />

                                    <DataGridTemplateColumn Header="Lun" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Lunes.Background}" CornerRadius="4" Padding="4,2" Margin="1">
                                                    <TextBlock Text="{Binding Lunes.Text}" Foreground="{Binding Lunes.Foreground}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Mar" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Martes.Background}" CornerRadius="4" Padding="4,2" Margin="1">
                                                    <TextBlock Text="{Binding Martes.Text}" Foreground="{Binding Martes.Foreground}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Mie" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Miercoles.Background}" CornerRadius="4" Padding="4,2" Margin="1">
                                                    <TextBlock Text="{Binding Miercoles.Text}" Foreground="{Binding Miercoles.Foreground}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Jue" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Jueves.Background}" CornerRadius="4" Padding="4,2" Margin="1">
                                                    <TextBlock Text="{Binding Jueves.Text}" Foreground="{Binding Jueves.Foreground}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Vie" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Viernes.Background}" CornerRadius="4" Padding="4,2" Margin="1">
                                                    <TextBlock Text="{Binding Viernes.Text}" Foreground="{Binding Viernes.Foreground}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Sab" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Sabado.Background}" CornerRadius="4" Padding="4,2" Margin="1">
                                                    <TextBlock Text="{Binding Sabado.Text}" Foreground="{Binding Sabado.Foreground}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Dom" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Domingo.Background}" CornerRadius="4" Padding="4,2" Margin="1">
                                                    <TextBlock Text="{Binding Domingo.Text}" Foreground="{Binding Domingo.Foreground}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Dashboard">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14" Effect="{StaticResource CardShadowEffect}">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Left">
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Desde" FontWeight="SemiBold" />
                                <DatePicker x:Name="DashboardDesdeInput" Width="140" Margin="0,0,14,0" />
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Hasta" FontWeight="SemiBold" />
                                <DatePicker x:Name="DashboardHastaInput" Width="140" Margin="0,0,14,0" />
                                <Button Content="Actualizar" Click="DashboardActualizarButton_Click" />
                            </WrapPanel>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FF4A6075" Text="{Binding DashboardPeriodo}" />
                        </DockPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Margin="0,14,0,0" Columns="3" Rows="2">
                        <Border Margin="0,0,10,10" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Clientes activos" Foreground="#FF4A6075" />
                                <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Text="{Binding DashboardClientesActivos}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,10" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Vehiculos activos" Foreground="#FF4A6075" />
                                <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Text="{Binding DashboardVehiculosActivos}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,0,10" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Stock total de partes" Foreground="#FF4A6075" />
                                <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Text="{Binding DashboardStockPartes}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Servicios en periodo" Foreground="#FF4A6075" />
                                <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Text="{Binding DashboardServiciosPeriodo}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Costo total servicios" Foreground="#FF4A6075" />
                                <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Text="{Binding DashboardCostoServiciosPeriodo}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,0,0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Reportes en periodo" Foreground="#FF4A6075" />
                                <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Text="{Binding DashboardReportesPeriodo}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="18,0,18,18" CornerRadius="10" Padding="12" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FF44566A" />
        </Border>
    </Grid>
</Window>


















