<Window x:Class="PipitaDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pipita Garage Desktop"
        Height="760"
        Width="1280"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F6FB">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#FFE2E8F0" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0F6FDE" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF0C59B2" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#FFEAF1FF" />

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF172535" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="18" CornerRadius="12" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
            <Grid Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Pipita Garage" FontSize="26" FontWeight="Bold" />
                    <TextBlock Margin="0,4,0,0" Text="App de escritorio para cargar datos de taller y vehiculos. Sin login." FontSize="14" Foreground="#FF4A6075" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Actualizar" Click="RefreshButton_Click" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#FF4A6075" Text="{Binding IsBusy, StringFormat=Cargando: {0}}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="18,0,18,12" FontSize="13" BorderBrush="{StaticResource BorderBrushSoft}">
            <TabItem Header="Clientes">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Ficha de cliente" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,14" Text="Carga rapida de contacto principal." Foreground="#FF4A6075" />

                                <TextBlock Text="Nombre" FontWeight="SemiBold" />
                                <TextBox x:Name="ClienteNombreInput" />

                                <TextBlock Text="Telefono" FontWeight="SemiBold" />
                                <TextBox x:Name="ClienteTelefonoInput" />

                                <TextBlock Text="Email" FontWeight="SemiBold" />
                                <TextBox x:Name="ClienteEmailInput" />

                                <TextBlock Text="Estado" FontWeight="SemiBold" />
                                <ComboBox x:Name="ClienteEstadoCombo" ItemsSource="{Binding EstadoClientes}" />

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Guardar cliente" Click="GuardarClienteButton_Click" />
                                    <Button Content="Nuevo" Click="NuevoClienteButton_Click" />
                                    <Button Content="Eliminar" Click="EliminarClienteButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="8,4,8,10" Text="Clientes cargados" FontSize="16" FontWeight="SemiBold" />
                            <DataGrid Grid.Row="1"
                                      x:Name="ClientesGrid"
                                      ItemsSource="{Binding Clientes}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="ClientesGrid_SelectionChanged"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" />
                                    <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="*" />
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Vehiculos">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Ficha de vehiculo" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,14" Text="Alta de vehiculos con asignacion opcional a cliente." Foreground="#FF4A6075" />

                                <TextBlock Text="Patente" FontWeight="SemiBold" />
                                <TextBox x:Name="VehiculoPatenteInput" />

                                <TextBlock Text="Marca" FontWeight="SemiBold" />
                                <TextBox x:Name="VehiculoMarcaInput" />

                                <TextBlock Text="Modelo" FontWeight="SemiBold" />
                                <TextBox x:Name="VehiculoModeloInput" />

                                <TextBlock Text="Version" FontWeight="SemiBold" />
                                <TextBox x:Name="VehiculoVersionInput" />

                                <TextBlock Text="Anio" FontWeight="SemiBold" />
                                <TextBox x:Name="VehiculoAnioInput" />

                                <TextBlock Text="Estado" FontWeight="SemiBold" />
                                <ComboBox x:Name="VehiculoEstadoCombo" ItemsSource="{Binding EstadoVehiculos}" />

                                <TextBlock Text="Cliente" FontWeight="SemiBold" />
                                <ComboBox x:Name="VehiculoClienteCombo"
                                          ItemsSource="{Binding ClienteOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Id" />

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Guardar vehiculo" Click="GuardarVehiculoButton_Click" />
                                    <Button Content="Nuevo" Click="NuevoVehiculoButton_Click" />
                                    <Button Content="Eliminar" Click="EliminarVehiculoButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="8,4,8,10" Text="Vehiculos cargados" FontSize="16" FontWeight="SemiBold" />
                            <DataGrid Grid.Row="1"
                                      x:Name="VehiculosGrid"
                                      ItemsSource="{Binding Vehiculos}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="VehiculosGrid_SelectionChanged"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Patente" Binding="{Binding Patente}" Width="*" />
                                    <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="*" />
                                    <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="*" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" />
                                    <DataGridTextColumn Header="Anio" Binding="{Binding Anio}" Width="*" />
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="18,0,18,18" CornerRadius="10" Padding="12" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FF44566A" />
        </Border>
    </Grid>
</Window>
