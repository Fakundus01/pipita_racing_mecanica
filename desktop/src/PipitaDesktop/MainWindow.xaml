<Window x:Class="PipitaDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pipita Garage Desktop"
        Height="780"
        Width="1320"
        MinHeight="720"
        MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Bahnschrift">
        <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF3F8FE" Offset="0" />
            <GradientStop Color="#FFE9F0FB" Offset="0.55" />
            <GradientStop Color="#FFF8FAFD" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#FFD4DFEC" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF165BB5" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF0D4997" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#FFEAF2FC" />
        <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#FFDDEBFB" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF4C6077" />
        <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="#FF173A63" />

        <Style x:Key="HeaderChipBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#36FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF1F2E43" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{StaticResource SecondaryHoverBrush}" />
                                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="#FFC0D3EA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#FFD3E4FA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF093F84" />
                    <Setter Property="BorderBrush" Value="#FF093F84" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="HeaderActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="#F4F8FD" />
            <Setter Property="BorderBrush" Value="#D1DEEE" />
            <Setter Property="Foreground" Value="#20364E" />
        </Style>

        <Style x:Key="HeaderPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderActionButtonStyle}">
            <Setter Property="Background" Value="#1B6DDA" />
            <Setter Property="BorderBrush" Value="#1B6DDA" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#135DBC" />
                    <Setter Property="BorderBrush" Value="#135DBC" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F4E9F" />
                    <Setter Property="BorderBrush" Value="#0F4E9F" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="FormActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Margin" Value="0,0,10,8" />
        </Style>

        <Style x:Key="FormPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="Margin" Value="0,0,10,8" />
        </Style>

        <Style x:Key="NotifyWhatsAppButtonStyle" TargetType="Button" BasedOn="{StaticResource FormActionButtonStyle}">
            <Setter Property="Background" Value="#E6F7EE" />
            <Setter Property="BorderBrush" Value="#B7E0C8" />
            <Setter Property="Foreground" Value="#156B3F" />
        </Style>

        <Style x:Key="NotifyEmailButtonStyle" TargetType="Button" BasedOn="{StaticResource FormActionButtonStyle}">
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="BorderBrush" Value="#C9D9F4" />
            <Setter Property="Foreground" Value="#214C87" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#D7E5F8" />
            <Setter Property="BorderBrush" Value="#C3D6EE" />
            <Setter Property="Foreground" Value="#FF3E5773" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                CornerRadius="12,12,0,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#E6EFFB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#C5D8EE" />
                                <Setter Property="Foreground" Value="#FF173551" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabRoot" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="#FFFFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#FFF5F9FF" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE1EAF5" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#FFD0DDED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFEAF2FD" />
            <Setter Property="Foreground" Value="#FF203A57" />
            <Setter Property="BorderBrush" Value="#FFD6E3F3" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="34" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFDDEBFE" />
                    <Setter Property="Foreground" Value="#FF0E3159" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF172535" />
        </Style>
    </Window.Resources>

        <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Canvas IsHitTestVisible="False">
            <Ellipse Width="360" Height="360" Fill="#18FFFFFF" Canvas.Left="-120" Canvas.Top="-90" />
            <Ellipse Width="500" Height="500" Fill="#14C1DAFF" Canvas.Right="-220" Canvas.Top="-180" />
        </Canvas>

        <Border Grid.Row="0" Margin="18,18,18,12" CornerRadius="18" BorderBrush="#3AE3ECF9" BorderThickness="1" Effect="{StaticResource CardShadowEffect}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0E4E93" Offset="0" />
                    <GradientStop Color="#FF1B6DC7" Offset="0.48" />
                    <GradientStop Color="#FF2B82DB" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PIPITA GARAGE" FontSize="12" Foreground="#D9FFFFFF" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0" Text="Panel operativo del taller" FontSize="30" FontWeight="Bold" Foreground="White" />
                    <TextBlock Margin="0,4,0,0" Text="Carga de clientes, autos, servicios, requests y distribuidoras. Sin login." FontSize="14" Foreground="#E6F3FF" />
                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource HeaderChipBorderStyle}">
                            <TextBlock Text="Base local segura" Foreground="White" />
                        </Border>
                        <Border Style="{StaticResource HeaderChipBorderStyle}">
                            <TextBlock Text="Exportacion Excel" Foreground="White" />
                        </Border>
                        <Border Style="{StaticResource HeaderChipBorderStyle}">
                            <TextBlock Text="Flujo simple de taller" Foreground="White" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Style="{StaticResource HeaderActionButtonStyle}" Content="Importar Excel" Click="ImportarExcelButton_Click" />
                        <Button Style="{StaticResource HeaderPrimaryActionButtonStyle}" Content="Exportar Excel" Click="ExportarExcelButton_Click" />
                        <Button Style="{StaticResource HeaderActionButtonStyle}" Content="Actualizar" Click="RefreshButton_Click" />
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Right" Foreground="#E5F2FF" FontWeight="SemiBold" Text="Actualizando datos..." Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
<TabControl Grid.Row="1" Margin="18,0,18,12" FontSize="13">
            <TabItem Header="Clientes">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16" Effect="{StaticResource CardShadowEffect}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Ficha de cliente" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,14" Text="Carga rapida de contacto principal." Foreground="#FF4A6075" />

                                <TextBlock Text="Nombre" FontWeight="SemiBold" />
                                <TextBox x:Name="ClienteNombreInput" />

                                <TextBlock Text="Telefono" FontWeight="SemiBold" />
                                <TextBox x:Name="ClienteTelefonoInput" />

                                <TextBlock Text="Email" FontWeight="SemiBold" />
                                <TextBox x:Name="ClienteEmailInput" />

                                <TextBlock Text="Estado" FontWeight="SemiBold" />
                                <ComboBox x:Name="ClienteEstadoCombo" ItemsSource="{Binding EstadoClientes}" />

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource FormPrimaryActionButtonStyle}" Content="Guardar cliente" Click="GuardarClienteButton_Click" />
                                    <Button Style="{StaticResource FormActionButtonStyle}" Content="Nuevo" Click="NuevoClienteButton_Click" />
                                    <Button Style="{StaticResource FormActionButtonStyle}" Content="Eliminar" Click="EliminarClienteButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10" Effect="{StaticResource CardShadowEffect}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="8,4,8,10" Text="Clientes cargados" FontSize="16" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="1" Margin="8,0,8,10">
                                <WrapPanel>
                                    <TextBox x:Name="ClientesFiltroTextoInput" Width="260" ToolTip="Buscar por nombre, telefono o email" TextChanged="AnyFilter_TextChanged" />
                                    <ComboBox x:Name="ClientesFiltroEstadoCombo" Width="160" ItemsSource="{Binding EstadoClientesConTodos}" SelectionChanged="AnyFilter_SelectionChanged" />
                                    <Button Content="Limpiar" Click="LimpiarFiltroClientesButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                            <DockPanel Grid.Row="2" Margin="8,0,8,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <Button Content="Anterior" IsEnabled="{Binding PuedeRetrocederClientes}" Click="ClientesPaginaAnteriorButton_Click" />
                                    <Button Content="Siguiente" IsEnabled="{Binding PuedeAvanzarClientes}" Click="ClientesPaginaSiguienteButton_Click" />
                                </StackPanel>
                                <TextBlock VerticalAlignment="Center" Foreground="#FF4A6075" Text="{Binding ClientesPaginacionTexto}" />
                            </DockPanel>
                            <DataGrid Grid.Row="3"
                                      x:Name="ClientesGrid"
                                      ItemsSource="{Binding Clientes}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="ClientesGrid_SelectionChanged"
                                      Sorting="ClientesGrid_Sorting"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" SortMemberPath="Nombre" />
                                    <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="*" SortMemberPath="Telefono" />
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" SortMemberPath="Email" />
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" SortMemberPath="Estado" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="4" Margin="8,14,8,10">
                                <DockPanel>
                                    <TextBlock Text="{Binding ClienteHistorialTitulo}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF4A6075" Text="{Binding ClienteHistorialResumen}" />
                                </DockPanel>
                                <UniformGrid Columns="5" Margin="0,12,0,0">
                                    <Border Margin="0,0,10,0" Padding="12" Background="#FFF7FAFE" BorderBrush="#D8E4F2" BorderThickness="1" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Autos" />
                                            <TextBlock Margin="0,6,0,0" FontSize="24" FontWeight="Bold" Text="{Binding ClienteHistorialAutosMetric}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,10,0" Padding="12" Background="#FFF7FAFE" BorderBrush="#D8E4F2" BorderThickness="1" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Solicitudes" />
                                            <TextBlock Margin="0,6,0,0" FontSize="24" FontWeight="Bold" Text="{Binding ClienteHistorialSolicitudesMetric}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,10,0" Padding="12" Background="#FFFFFBF1" BorderBrush="#E9DDBD" BorderThickness="1" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Servicios" />
                                            <TextBlock Margin="0,6,0,0" FontSize="24" FontWeight="Bold" Text="{Binding ClienteHistorialServiciosMetric}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,10,0" Padding="12" Background="#FFFFF8F3" BorderBrush="#EED9C9" BorderThickness="1" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Distribuidoras" />
                                            <TextBlock Margin="0,6,0,0" FontSize="24" FontWeight="Bold" Text="{Binding ClienteHistorialTercerosMetric}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" Background="#FFEFF7F2" BorderBrush="#D6E7DB" BorderThickness="1" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Total operativo" />
                                            <TextBlock Margin="0,6,0,0" FontSize="24" FontWeight="Bold" Text="{Binding ClienteHistorialTotalMetric}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                            <Grid Grid.Row="5" Margin="8,0,8,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="#FFF8FBFF" BorderBrush="#FFD8E4F2" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Margin="0,0,0,8" Text="Autos" FontWeight="SemiBold" />
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding ClienteHistorialVehiculos}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Patente" Binding="{Binding Patente}" Width="*" />
                                                <DataGridTextColumn Header="Vehiculo" Binding="{Binding Marca}" Width="*" />
                                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="2" Background="#FFF8FBFF" BorderBrush="#FFD8E4F2" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Margin="0,0,0,8" Text="Solicitudes" FontWeight="SemiBold" />
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding ClienteHistorialSolicitudes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Inicio" Binding="{Binding FechaHoraCita, StringFormat={}{0:dd/MM HH:mm}}" Width="*" />
                                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
                                                <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="2*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Background="#FFFFFAF1" BorderBrush="#FFE9DDBD" BorderThickness="1" CornerRadius="10" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Margin="0,0,0,8" Text="Servicios" FontWeight="SemiBold" />
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding ClienteHistorialServicios}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" Width="*" />
                                                <DataGridTextColumn Header="Patente" Binding="{Binding Patente}" Width="*" />
                                                <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="2*" />
                                                <DataGridTextColumn Header="Costo" Binding="{Binding Costo, StringFormat={}{0:C2}}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="2" Background="#FFFFFAF1" BorderBrush="#FFE9DDBD" BorderThickness="1" CornerRadius="10" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Margin="0,0,0,8" Text="Trabajos con distribuidoras" FontWeight="SemiBold" />
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding ClienteHistorialTrabajosDistribuidora}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" Width="*" />
                                                <DataGridTextColumn Header="Distribuidora" Binding="{Binding DistribuidoraNombre}" Width="*" />
                                                <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="2*" />
                                                <DataGridTextColumn Header="Costo" Binding="{Binding Costo, StringFormat={}{0:C2}}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Vehiculos">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
