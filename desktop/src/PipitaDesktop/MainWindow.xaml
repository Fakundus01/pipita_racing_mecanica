<Window x:Class="PipitaDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pipita Garage Desktop"
        Height="780"
        Width="1320"
        MinHeight="720"
        MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Bahnschrift">
        <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF3F8FE" Offset="0" />
            <GradientStop Color="#FFE9F0FB" Offset="0.55" />
            <GradientStop Color="#FFF8FAFD" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#FFD4DFEC" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF165BB5" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF0D4997" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#FFEAF2FC" />
        <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#FFDDEBFB" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF4C6077" />
        <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="#FF173A63" />

        <Style x:Key="HeaderChipBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#36FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF1F2E43" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{StaticResource SecondaryHoverBrush}" />
                                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="#FFC0D3EA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#FFD3E4FA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF093F84" />
                    <Setter Property="BorderBrush" Value="#FF093F84" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#D7E5F8" />
            <Setter Property="BorderBrush" Value="#C3D6EE" />
            <Setter Property="Foreground" Value="#FF3E5773" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                CornerRadius="12,12,0,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#E6EFFB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#C5D8EE" />
                                <Setter Property="Foreground" Value="#FF173551" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabRoot" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="#FFFFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#FFF5F9FF" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE1EAF5" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#FFD0DDED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFEAF2FD" />
            <Setter Property="Foreground" Value="#FF203A57" />
            <Setter Property="BorderBrush" Value="#FFD6E3F3" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="34" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFDDEBFE" />
                    <Setter Property="Foreground" Value="#FF0E3159" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF172535" />
        </Style>
    </Window.Resources>

        <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Canvas IsHitTestVisible="False">
            <Ellipse Width="360" Height="360" Fill="#18FFFFFF" Canvas.Left="-120" Canvas.Top="-90" />
            <Ellipse Width="500" Height="500" Fill="#14C1DAFF" Canvas.Right="-220" Canvas.Top="-180" />
        </Canvas>

        <Border Grid.Row="0" Margin="18,18,18,12" CornerRadius="18" BorderBrush="#3AE3ECF9" BorderThickness="1" Effect="{StaticResource CardShadowEffect}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0E4E93" Offset="0" />
                    <GradientStop Color="#FF1B6DC7" Offset="0.48" />
                    <GradientStop Color="#FF2B82DB" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PIPITA GARAGE" FontSize="12" Foreground="#D9FFFFFF" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0" Text="Panel operativo del taller" FontSize="30" FontWeight="Bold" Foreground="White" />
                    <TextBlock Margin="0,4,0,0" Text="Carga de clientes, autos, servicios, requests y distribuidoras. Sin login." FontSize="14" Foreground="#E6F3FF" />
                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource HeaderChipBorderStyle}">
                            <TextBlock Text="Base local segura" Foreground="White" />
                        </Border>
                        <Border Style="{StaticResource HeaderChipBorderStyle}">
                            <TextBlock Text="Exportacion Excel" Foreground="White" />
                        </Border>
                        <Border Style="{StaticResource HeaderChipBorderStyle}">
                            <TextBlock Text="Flujo simple de taller" Foreground="White" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Importar DB vieja" Click="ImportarLegacyDbButton_Click" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Exportar Excel" Click="ExportarExcelButton_Click" />
                        <Button Content="Actualizar" Click="RefreshButton_Click" />
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Right" Foreground="#E5F2FF" Text="{Binding IsBusy, StringFormat=Cargando: {0}}" />
                </StackPanel>
            </Grid>
        </Border>
<TabControl Grid.Row="1" Margin="18,0,18,12" FontSize="13">
            <TabItem Header="Clientes">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16" Effect="{StaticResource CardShadowEffect}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Ficha de cliente" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,14" Text="Carga rapida de contacto principal." Foreground="#FF4A6075" />

                                <TextBlock Text="Nombre" FontWeight="SemiBold" />
                                <TextBox x:Name="ClienteNombreInput" />

                                <TextBlock Text="Telefono" FontWeight="SemiBold" />
                                <TextBox x:Name="ClienteTelefonoInput" />

                                <TextBlock Text="Email" FontWeight="SemiBold" />
                                <TextBox x:Name="ClienteEmailInput" />

                                <TextBlock Text="Estado" FontWeight="SemiBold" />
                                <ComboBox x:Name="ClienteEstadoCombo" ItemsSource="{Binding EstadoClientes}" />

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Guardar cliente" Click="GuardarClienteButton_Click" />
                                    <Button Content="Nuevo" Click="NuevoClienteButton_Click" />
                                    <Button Content="Eliminar" Click="EliminarClienteButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10" Effect="{StaticResource CardShadowEffect}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="8,4,8,10" Text="Clientes cargados" FontSize="16" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="1" Margin="8,0,8,10">
                                <WrapPanel>
                                    <TextBox x:Name="ClientesFiltroTextoInput" Width="260" ToolTip="Buscar por nombre, telefono o email" TextChanged="AnyFilter_TextChanged" />
                                    <ComboBox x:Name="ClientesFiltroEstadoCombo" Width="160" ItemsSource="{Binding EstadoClientesConTodos}" SelectionChanged="AnyFilter_SelectionChanged" />
                                    <Button Content="Limpiar" Click="LimpiarFiltroClientesButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                            <DataGrid Grid.Row="2"
                                      x:Name="ClientesGrid"
                                      ItemsSource="{Binding Clientes}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="ClientesGrid_SelectionChanged"
                                      Sorting="ClientesGrid_Sorting"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" SortMemberPath="Nombre" />
                                    <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="*" SortMemberPath="Telefono" />
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" SortMemberPath="Email" />
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" SortMemberPath="Estado" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="3" Margin="8,10,8,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <Button Content="Anterior" IsEnabled="{Binding PuedeRetrocederClientes}" Click="ClientesPaginaAnteriorButton_Click" />
                                    <Button Content="Siguiente" IsEnabled="{Binding PuedeAvanzarClientes}" Click="ClientesPaginaSiguienteButton_Click" />
                                </StackPanel>
                                <TextBlock VerticalAlignment="Center" Foreground="#FF4A6075" Text="{Binding ClientesPaginacionTexto}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Vehiculos">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16" Effect="{StaticResource CardShadowEffect}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Ficha de vehiculo" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,14" Text="Alta de vehiculos con asignacion opcional a cliente." Foreground="#FF4A6075" />

                                <TextBlock Text="Patente" FontWeight="SemiBold" />
                                <TextBox x:Name="VehiculoPatenteInput" />

                                <TextBlock Text="Marca" FontWeight="SemiBold" />
                                <TextBox x:Name="VehiculoMarcaInput" />

                                <TextBlock Text="Modelo" FontWeight="SemiBold" />
                                <TextBox x:Name="VehiculoModeloInput" />

                                <TextBlock Text="Version" FontWeight="SemiBold" />
                                <TextBox x:Name="VehiculoVersionInput" />

                                <TextBlock Text="Anio" FontWeight="SemiBold" />
                                <TextBox x:Name="VehiculoAnioInput" />

                                <TextBlock Text="Estado" FontWeight="SemiBold" />
                                <ComboBox x:Name="VehiculoEstadoCombo" ItemsSource="{Binding EstadoVehiculos}" />

                                <TextBlock Text="Cliente" FontWeight="SemiBold" />
                                <ComboBox x:Name="VehiculoClienteCombo"
                                          ItemsSource="{Binding ClienteOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Id" />

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Guardar vehiculo" Click="GuardarVehiculoButton_Click" />
                                    <Button Content="Nuevo" Click="NuevoVehiculoButton_Click" />
                                    <Button Content="Eliminar" Click="EliminarVehiculoButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10" Effect="{StaticResource CardShadowEffect}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="8,4,8,10" Text="Vehiculos cargados" FontSize="16" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="1" Margin="8,0,8,10">
                                <WrapPanel>
                                    <TextBox x:Name="VehiculosFiltroTextoInput" Width="230" ToolTip="Buscar por patente, marca o modelo" TextChanged="AnyFilter_TextChanged" />
                                    <ComboBox x:Name="VehiculosFiltroEstadoCombo" Width="160" ItemsSource="{Binding EstadoVehiculosConTodos}" SelectionChanged="AnyFilter_SelectionChanged" />
                                    <ComboBox x:Name="VehiculosFiltroClienteCombo" Width="220" ItemsSource="{Binding ClienteFilterOptions}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="AnyFilter_SelectionChanged" />
                                    <Button Content="Limpiar" Click="LimpiarFiltroVehiculosButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                            <DataGrid Grid.Row="2"
                                      x:Name="VehiculosGrid"
                                      ItemsSource="{Binding Vehiculos}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="VehiculosGrid_SelectionChanged"
                                      Sorting="VehiculosGrid_Sorting"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Patente" Binding="{Binding Patente}" Width="*" SortMemberPath="Patente" />
                                    <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="*" SortMemberPath="Marca" />
                                    <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="*" SortMemberPath="Modelo" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" SortMemberPath="Version" />
                                    <DataGridTextColumn Header="Anio" Binding="{Binding Anio}" Width="*" SortMemberPath="Anio" />
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" SortMemberPath="Estado" />
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="2*" SortMemberPath="ClienteNombre" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="3" Margin="8,10,8,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <Button Content="Anterior" IsEnabled="{Binding PuedeRetrocederVehiculos}" Click="VehiculosPaginaAnteriorButton_Click" />
                                    <Button Content="Siguiente" IsEnabled="{Binding PuedeAvanzarVehiculos}" Click="VehiculosPaginaSiguienteButton_Click" />
                                </StackPanel>
                                <TextBlock VerticalAlignment="Center" Foreground="#FF4A6075" Text="{Binding VehiculosPaginacionTexto}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Partes">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16" Effect="{StaticResource CardShadowEffect}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Ficha de parte" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,14" Text="Inventario de repuestos y accesorios." Foreground="#FF4A6075" />

                                <TextBlock Text="Nombre" FontWeight="SemiBold" />
                                <TextBox x:Name="ParteNombreInput" />

                                <TextBlock Text="Stock" FontWeight="SemiBold" />
                                <TextBox x:Name="ParteStockInput" />

                                <TextBlock Text="Precio c/u" FontWeight="SemiBold" />
                                <TextBox x:Name="ParteCostoInput" />

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Guardar parte" Click="GuardarParteButton_Click" />
                                    <Button Content="Nuevo" Click="NuevoParteButton_Click" />
                                    <Button Content="Eliminar" Click="EliminarParteButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10" Effect="{StaticResource CardShadowEffect}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="8,4,8,10" Text="Partes cargadas" FontSize="16" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="1" Margin="8,0,8,10">
                                <WrapPanel>
                                    <TextBox x:Name="PartesFiltroTextoInput" Width="320" ToolTip="Buscar por nombre" TextChanged="AnyFilter_TextChanged" />
                                    <Button Content="Limpiar" Click="LimpiarFiltroPartesButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                            <DataGrid Grid.Row="2"
                                      x:Name="PartesGrid"
                                      ItemsSource="{Binding Partes}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="PartesGrid_SelectionChanged"
                                      Sorting="PartesGrid_Sorting"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" SortMemberPath="Nombre" />
                                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="*" SortMemberPath="Stock" />
                                    <DataGridTextColumn Header="Precio c/u" Binding="{Binding Costo, StringFormat={}{0:C2}}" Width="*" SortMemberPath="Costo" />
                                    <DataGridTextColumn Header="Creado" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="*" SortMemberPath="CreatedAt" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="3" Margin="8,10,8,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <Button Content="Anterior" IsEnabled="{Binding PuedeRetrocederPartes}" Click="PartesPaginaAnteriorButton_Click" />
                                    <Button Content="Siguiente" IsEnabled="{Binding PuedeAvanzarPartes}" Click="PartesPaginaSiguienteButton_Click" />
                                </StackPanel>
                                <TextBlock VerticalAlignment="Center" Foreground="#FF4A6075" Text="{Binding PartesPaginacionTexto}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Servicios">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="370" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16" Effect="{StaticResource CardShadowEffect}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Ficha de servicio" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,14" Text="Historial de tareas por vehiculo." Foreground="#FF4A6075" />

                                <TextBlock Text="Vehiculo" FontWeight="SemiBold" />
