                                <TextBox x:Name="DistribuidoraNotasInput" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource FormPrimaryActionButtonStyle}" Content="Guardar distribuidora" Click="GuardarDistribuidoraButton_Click" />
                                    <Button Style="{StaticResource FormActionButtonStyle}" Content="Nuevo" Click="NuevoDistribuidoraButton_Click" />
                                    <Button Style="{StaticResource FormActionButtonStyle}" Content="Eliminar" Click="EliminarDistribuidoraButton_Click" />
                                </WrapPanel>

                                <Border Margin="0,16,0,14" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" />

                                <TextBlock Text="Trabajo tercerizado" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,14" Text="Carga de trabajos y costos pagados a terceros." Foreground="#FF4A6075" />

                                <TextBlock Text="Distribuidora" FontWeight="SemiBold" />
                                <ComboBox x:Name="TrabajoDistribuidoraCombo"
                                          ItemsSource="{Binding DistribuidoraOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Id" />

                                <TextBlock Text="Cliente" FontWeight="SemiBold" />
                                <ComboBox x:Name="TrabajoClienteCombo"
                                          ItemsSource="{Binding ClienteOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Id" />

                                <TextBlock Text="Vehiculo" FontWeight="SemiBold" />
                                <ComboBox x:Name="TrabajoVehiculoCombo"
                                          ItemsSource="{Binding VehiculoOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Id" />

                                <TextBlock Text="Fecha" FontWeight="SemiBold" />
                                <DatePicker x:Name="TrabajoFechaInput" />

                                <TextBlock Text="Estado pago" FontWeight="SemiBold" />
                                <ComboBox x:Name="TrabajoEstadoPagoCombo" ItemsSource="{Binding EstadoPagoTrabajoDistribuidora}" />

                                <TextBlock Text="Costo" FontWeight="SemiBold" />
                                <TextBox x:Name="TrabajoCostoInput" />

                                <TextBlock Text="Descripcion" FontWeight="SemiBold" />
                                <TextBox x:Name="TrabajoDescripcionInput" />

                                <TextBlock Text="Notas" FontWeight="SemiBold" />
                                <TextBox x:Name="TrabajoNotasInput" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource FormPrimaryActionButtonStyle}" Content="Guardar trabajo" Click="GuardarTrabajoDistribuidoraButton_Click" />
                                    <Button Style="{StaticResource FormActionButtonStyle}" Content="Nuevo" Click="NuevoTrabajoDistribuidoraButton_Click" />
                                    <Button Style="{StaticResource FormActionButtonStyle}" Content="Eliminar" Click="EliminarTrabajoDistribuidoraButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10" Effect="{StaticResource CardShadowEffect}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="8,4,8,10">
                                <TextBlock Text="Distribuidoras registradas" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF4A6075" Text="{Binding ResumenGastoDistribuidoras, StringFormat=Gasto total: {0}}" />
                            </DockPanel>

                            <StackPanel Grid.Row="1" Margin="8,0,8,10">
                                <WrapPanel>
                                    <TextBox x:Name="DistribuidorasFiltroTextoInput" Width="220" ToolTip="Buscar por nombre o rubro" TextChanged="AnyFilter_TextChanged" />
                                    <ComboBox x:Name="DistribuidorasFiltroEstadoCombo" Width="150" ItemsSource="{Binding EstadoDistribuidorasConTodos}" SelectionChanged="AnyFilter_SelectionChanged" />
                                    <Button Content="Limpiar" Click="LimpiarFiltroDistribuidorasButton_Click" />
                                </WrapPanel>
                            </StackPanel>

                            <DataGrid Grid.Row="2"
                                      x:Name="DistribuidorasGrid"
                                      ItemsSource="{Binding Distribuidoras}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="DistribuidorasGrid_SelectionChanged"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" />
                                    <DataGridTextColumn Header="Rubro" Binding="{Binding Rubro}" Width="*" />
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
                                    <DataGridTextColumn Header="Gasto total" Binding="{Binding GastoTotal, StringFormat={}{0:C2}}" Width="*" />
                                    <DataGridTextColumn Header="Trabajos" Binding="{Binding CantidadTrabajos}" Width="*" />
                                    <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="3" Margin="8,12,8,10" Text="Trabajos tercerizados" FontSize="16" FontWeight="SemiBold" />

                            <StackPanel Grid.Row="4" Margin="8,0,8,10">
                                <WrapPanel>
                                    <TextBox x:Name="TrabajosDistribuidoraFiltroTextoInput" Width="240" ToolTip="Buscar por distribuidora, cliente, patente o descripcion" TextChanged="AnyFilter_TextChanged" />
                                    <ComboBox x:Name="TrabajosDistribuidoraFiltroDistribuidoraCombo"
                                              Width="230"
                                              ItemsSource="{Binding DistribuidoraFilterOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Id"
                                              SelectionChanged="AnyFilter_SelectionChanged" />
                                    <Button Content="Limpiar" Click="LimpiarFiltroTrabajosDistribuidoraButton_Click" />
                                </WrapPanel>
                            </StackPanel>

                            <DataGrid Grid.Row="5"
                                      x:Name="TrabajosDistribuidoraGrid"
                                      ItemsSource="{Binding TrabajosDistribuidora}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="TrabajosDistribuidoraGrid_SelectionChanged"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" Width="*" />
                                    <DataGridTextColumn Header="Distribuidora" Binding="{Binding DistribuidoraNombre}" Width="2*" />
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*" />
                                    <DataGridTextColumn Header="Patente" Binding="{Binding Patente}" Width="*" />
                                    <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="2*" />
                                    <DataGridTextColumn Header="Costo" Binding="{Binding Costo, StringFormat={}{0:C2}}" Width="*" />
                                    <DataGridTextColumn Header="Estado pago" Binding="{Binding EstadoPago}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Agenda">
                <Grid Margin="14">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14" Effect="{StaticResource CardShadowEffect}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,14">
                                <Border Margin="0,0,10,0" Padding="14" Background="#FFF8FBFF" BorderBrush="#FFD4DFEC" BorderThickness="1" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Citas del mes" />
                                        <TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="Bold" Text="{Binding AgendaMesTotalCitas}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,10,0" Padding="14" Background="#FFF3F9FF" BorderBrush="#FFD4DFEC" BorderThickness="1" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Dias ocupados" />
                                        <TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="Bold" Text="{Binding AgendaMesDiasConCitas}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,10,0" Padding="14" Background="#FFFFF9ED" BorderBrush="#FFE9D9A3" BorderThickness="1" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Dia mas cargado" />
                                        <TextBlock Margin="0,8,0,0" FontSize="24" FontWeight="Bold" Text="{Binding AgendaMesDiaMasCargado}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="14" Background="#FFF4FBF7" BorderBrush="#FFD5E9DC" BorderThickness="1" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Seleccionado" />
                                        <TextBlock Margin="0,8,0,0" FontSize="24" FontWeight="Bold" Text="{Binding AgendaDiaTotalCitas, StringFormat={}{0} cita(s)}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <DockPanel Grid.Row="1" Margin="2,2,2,12">
                                <WrapPanel DockPanel.Dock="Left">
                                    <Button Content="&lt;" Width="42" Click="AgendaMesAnteriorButton_Click" />
                                    <Button Content="Hoy" Click="AgendaHoyButton_Click" />
                                    <Button Content="&gt;" Width="42" Click="AgendaMesSiguienteButton_Click" />
                                </WrapPanel>
                                <WrapPanel HorizontalAlignment="Right">
                                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Estado" FontWeight="SemiBold" />
                                    <ComboBox x:Name="AgendaFiltroEstadoCombo" Width="180" ItemsSource="{Binding EstadoSolicitudesConTodos}" SelectionChanged="AgendaFiltroEstadoCombo_SelectionChanged" />
                                </WrapPanel>
                            </DockPanel>

                            <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                                <Border Margin="0,0,10,0" Padding="12,6" Background="#FFD9F1FF" BorderBrush="#FF8BC9E8" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Foreground="#FF0B5276" FontSize="12" FontWeight="SemiBold" Text="Confirmada" />
                                </Border>
                                <Border Margin="0,0,10,0" Padding="12,6" Background="#FFFDF0C4" BorderBrush="#FFE0C15A" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Foreground="#FF7A4F00" FontSize="12" FontWeight="SemiBold" Text="Pendiente" />
                                </Border>
                                <Border Margin="0,0,10,0" Padding="12,6" Background="#FFFEDFCF" BorderBrush="#FFE5B695" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Foreground="#FF8A3F00" FontSize="12" FontWeight="SemiBold" Text="En proceso" />
                                </Border>
                                <Border Margin="0,0,10,0" Padding="12,6" Background="#FFDDF7E5" BorderBrush="#FF9ED0AC" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Foreground="#FF166B2F" FontSize="12" FontWeight="SemiBold" Text="Completada" />
                                </Border>
                                <Border Padding="12,6" Background="#FFF1D9DC" BorderBrush="#FFD5A0A7" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Foreground="#FF8E2430" FontSize="12" FontWeight="SemiBold" Text="Cancelada" />
                                </Border>
                            </WrapPanel>

                            <Border Grid.Row="3" CornerRadius="10,10,0,0" Background="#FF1676E6" Padding="0,12,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="42" FontWeight="Bold" Foreground="White" Text="{Binding AgendaMesTitulo}" />
                                    <UniformGrid Grid.Row="1" Columns="7" Margin="0,10,0,0">
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Dom" />
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Lun" />
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Mar" />
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Mie" />
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Jue" />
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Vie" />
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Sab" />
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4" BorderBrush="#FFD2DEEE" BorderThickness="1" Background="White" Padding="0">
                                <ItemsControl ItemsSource="{Binding AgendaDiasMes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="AgendaDiaButton_Click" Margin="0" Padding="0" BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}" OverridesDefaultStyle="True">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Border x:Name="DayCellBorder" BorderBrush="{Binding CellBorderBrush}" BorderThickness="0.5" Background="{Binding CellBackground}" MinHeight="132" Padding="10">
                                                    <Grid>
                                                        <Border x:Name="DayNumberBadge"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Padding="11,5"
                                                                BorderBrush="{Binding CellBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="12"
                                                                Background="{Binding DayNumberBackground}">
                                                            <TextBlock x:Name="DayNumberText"
                                                                       MinWidth="18"
                                                                       TextAlignment="Center"
                                                                       FontSize="24"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding DayNumberForeground}"
                                                                       Text="{Binding DayNumber}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter TargetName="DayCellBorder" Property="Opacity" Value="0.35" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="DayCellBorder" Property="BorderBrush" Value="#FF1574E6" />
                                                    <Setter TargetName="DayCellBorder" Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="DayCellBorder" Property="Background" Value="#FFF6E27A" />
                                                    <Setter TargetName="DayCellBorder" Property="BorderBrush" Value="#FFE1BE28" />
                                                    <Setter TargetName="DayCellBorder" Property="BorderThickness" Value="2" />
                                                    <Setter TargetName="DayNumberBadge" Property="Background" Value="#FFFCEBA4" />
                                                    <Setter TargetName="DayNumberBadge" Property="BorderBrush" Value="#FFE1BE28" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Agenda detalle">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,14">
                        <Border Margin="0,0,10,0" Padding="14" Background="#FFF8FBFF" BorderBrush="#FFD4DFEC" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Citas del dia" />
                                <TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="Bold" Text="{Binding AgendaDiaTotalCitas}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="14" Background="#FFFFF9ED" BorderBrush="#FFE9D9A3" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Primer turno" />
                                <TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="Bold" Text="{Binding AgendaDiaPrimerTurno}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="14" Background="#FFF4FBF7" BorderBrush="#FFD5E9DC" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Horas reservadas" />
                                <TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="Bold" Text="{Binding AgendaDiaHorasAsignadas}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="14" Background="#FFF4F7FD" BorderBrush="#FFD4DFEC" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Citas en semana" />
                                <TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="Bold" Text="{Binding AgendaSemanaTotalCitas}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14" Effect="{StaticResource CardShadowEffect}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold" Text="Citas del dia" />
                                <StackPanel Grid.Row="1" Margin="0,6,0,14">
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding AgendaResumenDia}" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <TextBlock Margin="0,8,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Mensaje" />
                                        <ComboBox x:Name="AgendaNotificacionTipoCombo" Width="220" SelectedIndex="0">
                                            <ComboBoxItem Content="Recordatorio de cita" />
                                            <ComboBoxItem Content="Cita proxima" />
                                            <ComboBoxItem Content="Auto listo" />
                                        </ComboBox>
                                    </WrapPanel>
                                </StackPanel>

                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CitasDiaSeleccionado}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10" Padding="14" Background="#FFFBFCFE" BorderBrush="#FFD7E0EA" BorderThickness="1" CornerRadius="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="88" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Background="#FFEAF2FF" CornerRadius="10" Padding="10">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="#FF174D8C" Text="{Binding FechaHoraInicio, StringFormat={}{0:HH:mm}}" />
                                                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="#FF4C6077" Text="{Binding FechaHoraFin, StringFormat={}{0:HH:mm}}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding ClienteNombre}" />
                                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Patente, StringFormat=Patente: {0}}" />
                                                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Motivo}" />
                                                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="{Binding Notas}" />
                                                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding AvisoResumen}" />
                                                            <WrapPanel Margin="0,12,0,0">
                                                                <Button Style="{StaticResource NotifyWhatsAppButtonStyle}" Content="WhatsApp" Click="AvisoWhatsAppAgendaButton_Click" />
                                                                <Button Style="{StaticResource NotifyEmailButtonStyle}" Content="Email" Click="AvisoEmailAgendaButton_Click" />
                                                                <Button Style="{StaticResource FormActionButtonStyle}" Padding="12,6" Content="Copiar mensaje" Click="CopiarMensajeAgendaButton_Click" />
                                                            </WrapPanel>
                                                        </StackPanel>

                                                        <Border Grid.Column="3" Background="{Binding EstadoBadgeBackground}" BorderBrush="{Binding EstadoBadgeBorder}" BorderThickness="1" CornerRadius="8" Padding="12,6" MinWidth="104" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding EstadoBadgeText}" Foreground="{Binding EstadoBadgeForeground}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14" Effect="{StaticResource CardShadowEffect}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0">
                                    <TextBlock DockPanel.Dock="Left" FontSize="18" FontWeight="SemiBold" Text="Vista semanal" />
                                    <TextBlock Margin="12,2,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding AgendaSemanaRango}" />
                                </DockPanel>

                                <TextBlock Grid.Row="1" Margin="0,6,0,14" Foreground="{StaticResource MutedTextBrush}" Text="Cruce rapido por hora para ver choques y espacios disponibles." />

                                <DataGrid Grid.Row="2"
                                          x:Name="AgendaSemanaGrid"
                                          ItemsSource="{Binding AgendaSemanaSlots}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          BorderThickness="0"
                                          RowHeight="38"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="*" />

                                        <DataGridTemplateColumn Header="Lun" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Lunes.Background}" CornerRadius="6" Padding="6,3" Margin="1"><TextBlock Text="{Binding Lunes.Text}" Foreground="{Binding Lunes.Foreground}" FontSize="10" TextWrapping="Wrap" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Mar" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Martes.Background}" CornerRadius="6" Padding="6,3" Margin="1"><TextBlock Text="{Binding Martes.Text}" Foreground="{Binding Martes.Foreground}" FontSize="10" TextWrapping="Wrap" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Mie" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Miercoles.Background}" CornerRadius="6" Padding="6,3" Margin="1"><TextBlock Text="{Binding Miercoles.Text}" Foreground="{Binding Miercoles.Foreground}" FontSize="10" TextWrapping="Wrap" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Jue" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Jueves.Background}" CornerRadius="6" Padding="6,3" Margin="1"><TextBlock Text="{Binding Jueves.Text}" Foreground="{Binding Jueves.Foreground}" FontSize="10" TextWrapping="Wrap" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Vie" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Viernes.Background}" CornerRadius="6" Padding="6,3" Margin="1"><TextBlock Text="{Binding Viernes.Text}" Foreground="{Binding Viernes.Foreground}" FontSize="10" TextWrapping="Wrap" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Sab" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Sabado.Background}" CornerRadius="6" Padding="6,3" Margin="1"><TextBlock Text="{Binding Sabado.Text}" Foreground="{Binding Sabado.Foreground}" FontSize="10" TextWrapping="Wrap" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Dom" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Domingo.Background}" CornerRadius="6" Padding="6,3" Margin="1"><TextBlock Text="{Binding Domingo.Text}" Foreground="{Binding Domingo.Foreground}" FontSize="10" TextWrapping="Wrap" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Dashboard">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14" Effect="{StaticResource CardShadowEffect}">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Left">
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Desde" FontWeight="SemiBold" />
                                <DatePicker x:Name="DashboardDesdeInput" Width="140" Margin="0,0,14,0" />
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Hasta" FontWeight="SemiBold" />
                                <DatePicker x:Name="DashboardHastaInput" Width="140" Margin="0,0,14,0" />
                                <Button Content="Actualizar" Click="DashboardActualizarButton_Click" />
                            </WrapPanel>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FF4A6075" Text="{Binding DashboardPeriodo}" />
                        </DockPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Margin="0,14,0,0" Columns="3" Rows="2">
                        <Border Margin="0,0,10,10" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Clientes activos" Foreground="#FF4A6075" />
                                <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Text="{Binding DashboardClientesActivos}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,10" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Vehiculos activos" Foreground="#FF4A6075" />
                                <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Text="{Binding DashboardVehiculosActivos}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,0,10" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Stock total de partes" Foreground="#FF4A6075" />
                                <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Text="{Binding DashboardStockPartes}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Servicios en periodo" Foreground="#FF4A6075" />
                                <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Text="{Binding DashboardServiciosPeriodo}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Costo total servicios" Foreground="#FF4A6075" />
                                <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Text="{Binding DashboardCostoServiciosPeriodo}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,0,0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Reportes en periodo" Foreground="#FF4A6075" />
                                <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Text="{Binding DashboardReportesPeriodo}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="18,0,18,18" CornerRadius="10" Padding="12" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FF44566A" />
        </Border>
    </Grid>
</Window>








