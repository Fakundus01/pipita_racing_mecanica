<Window x:Class="PipitaDesktop.ProfilePinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingresar PIN"
        Height="260"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        FontFamily="Bahnschrift">
    <Border Margin="18" Background="White" BorderBrush="#D6E1EF" BorderThickness="1" CornerRadius="16" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Perfil protegido" FontSize="24" FontWeight="Bold" Foreground="#1C3552" />
            <TextBlock Grid.Row="1" x:Name="ProfileNameText" Margin="0,8,0,0" Foreground="#5C7287" />
            <TextBlock Grid.Row="2" Margin="0,18,0,6" Text="Ingresa el PIN" FontWeight="SemiBold" />
            <PasswordBox Grid.Row="3" x:Name="PinInput" Height="36" Padding="10,6" VerticalAlignment="Top" />
            <WrapPanel Grid.Row="4" Margin="0,16,0,0">
                <Button MinWidth="120" Padding="14,10" Content="Ingresar" Click="IngresarButton_Click" />
                <Button MinWidth="120" Padding="14,10" Content="Cancelar" Click="CancelarButton_Click" />
            </WrapPanel>
        </Grid>
    </Border>
</Window>
