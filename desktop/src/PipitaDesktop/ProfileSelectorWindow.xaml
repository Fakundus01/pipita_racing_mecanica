<Window x:Class="PipitaDesktop.ProfileSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar perfil"
        Height="560"
        Width="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB"
        FontFamily="Bahnschrift">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="White" BorderBrush="#D6E1EF" BorderThickness="1" CornerRadius="16" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Perfiles locales" FontSize="24" FontWeight="Bold" Foreground="#1C3552" />
                    <TextBlock Margin="0,6,0,0" Text="Cada perfil usa su propia base de datos local." Foreground="#5C7287" />
                </StackPanel>

                <ListBox x:Name="ProfilesListBox"
                         Grid.Row="1"
                         Margin="0,18,0,18"
                         DisplayMemberPath="Name"
                         SelectionChanged="ProfilesListBox_SelectionChanged"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="Padding" Value="14,12" />
                            <Setter Property="Background" Value="#F8FBFF" />
                            <Setter Property="BorderBrush" Value="#D7E3F0" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="12"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#DDEBFE" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#8AB5EA" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#EEF5FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <WrapPanel Grid.Row="2">
                    <Button MinWidth="130" Padding="14,10" Content="Abrir perfil" Click="AbrirPerfilButton_Click" />
                    <Button MinWidth="120" Padding="14,10" Content="Cancelar" Click="CancelarButton_Click" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="White" BorderBrush="#D6E1EF" BorderThickness="1" CornerRadius="16" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Gestionar perfiles" FontSize="22" FontWeight="Bold" Foreground="#1C3552" />
                <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="Perfil seleccionado" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" x:Name="SelectedProfileText" Margin="0,4,0,14" Foreground="#5C7287" Text="Sin seleccion" />

                <TextBlock Grid.Row="3" Text="Nombre del perfil" FontWeight="SemiBold" />
                <TextBox Grid.Row="4" x:Name="ProfileNameInput" Margin="0,6,0,10" Height="34" Padding="10,6" />

                <TextBlock Grid.Row="5" Text="PIN opcional para nuevo perfil" FontWeight="SemiBold" />
                <StackPanel Grid.Row="6">
                    <PasswordBox x:Name="ProfilePinInput" Margin="0,6,0,12" Height="34" Padding="10,6" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button MinWidth="120" Padding="14,10" Content="Crear perfil" Click="CrearPerfilButton_Click" />
                        <Button MinWidth="120" Padding="14,10" Content="Renombrar" Click="RenombrarPerfilButton_Click" />
                        <Button MinWidth="120" Padding="14,10" Content="Eliminar" Click="EliminarPerfilButton_Click" />
                    </WrapPanel>
                    <TextBlock Text="Si el perfil tiene PIN, se pedira al entrar." Foreground="#5C7287" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
