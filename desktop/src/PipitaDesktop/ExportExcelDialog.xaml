<Window x:Class="PipitaDesktop.ExportExcelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar Excel"
        Width="560"
        Height="430"
        MinHeight="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FB"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F6FDE" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#095CC0" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#EEF4FB" />
        <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#DFEAF8" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#203040" />
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2E43" />
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="BorderBrush" Value="#D5E1EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{StaticResource SecondaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="36" />
            <Setter Property="BorderBrush" Value="#D5E1EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Margin="16"
            Background="White"
            BorderBrush="#D8E2EF"
            BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Exportar a Excel"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock Margin="0,8,0,18"
                               Foreground="#5D7287"
                               TextWrapping="Wrap"
                               Text="Elegi si queres actualizar un Excel existente o generar uno nuevo. El archivo se guarda en Documentos." />

                    <Border Padding="12"
                            CornerRadius="12"
                            Background="#F7FAFE"
                            BorderBrush="#D8E2EF"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Carpeta destino" />
                            <TextBlock x:Name="DestinationFolderText" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,18,0,0">
                        <TextBlock FontWeight="SemiBold" Text="Nombre del archivo" />
                        <TextBox x:Name="FileNameInput" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Margin="0,18,0,0"
                            Padding="14"
                            CornerRadius="12"
                            Background="#FBFCFE"
                            BorderBrush="#D8E2EF"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Text="Modo de exportacion" />
                            <RadioButton x:Name="ReemplazarExistenteOption"
                                         IsChecked="True"
                                         Content="Reemplazar existente"
                                         FontWeight="SemiBold" />
                            <TextBlock Margin="24,4,0,12" Foreground="#5D7287" TextWrapping="Wrap" Text="Si el archivo ya existe, se actualiza ese mismo Excel." />
                            <RadioButton x:Name="CrearNuevoOption"
                                         Content="Crear uno nuevo"
                                         FontWeight="SemiBold" />
                            <TextBlock Margin="24,4,0,0" Foreground="#5D7287" TextWrapping="Wrap" Text="Si el nombre ya existe, se crea una copia nueva con numeracion automatica." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Background="#F8FBFF" BorderBrush="#D8E2EF" BorderThickness="0,1,0,0" Padding="20,16">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogButtonStyle}" Content="Cancelar" Click="CancelarButton_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Exportar" Click="AceptarButton_Click" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
