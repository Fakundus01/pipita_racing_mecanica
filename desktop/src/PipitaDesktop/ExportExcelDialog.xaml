<Window x:Class="PipitaDesktop.ExportExcelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar Excel"
        Width="540"
        Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FB">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F6FDE" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#203040" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Padding="20"
            Background="White"
            BorderBrush="#D8E2EF"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Exportar a Excel"
                       FontSize="24"
                       FontWeight="Bold" />
            <TextBlock Grid.Row="1"
                       Margin="0,8,0,18"
                       Foreground="#5D7287"
                       Text="Elegi si queres actualizar un Excel existente o generar uno nuevo. El archivo se guarda en Documentos." />

            <Border Grid.Row="2"
                    Padding="12"
                    CornerRadius="10"
                    Background="#F7FAFE"
                    BorderBrush="#D8E2EF"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Carpeta destino" />
                    <TextBlock x:Name="DestinationFolderText" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock FontWeight="SemiBold" Text="Nombre del archivo" />
                <TextBox x:Name="FileNameInput" Margin="0,8,0,0" Height="34" VerticalContentAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="4"
                    Margin="0,18,0,0"
                    Padding="14"
                    CornerRadius="10"
                    Background="#FBFCFE"
                    BorderBrush="#D8E2EF"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Text="Modo de exportacion" />
                    <RadioButton x:Name="ReemplazarExistenteOption"
                                 IsChecked="True"
                                 Content="Reemplazar existente"
                                 FontWeight="SemiBold" />
                    <TextBlock Margin="24,4,0,12" Foreground="#5D7287" Text="Si el archivo ya existe, se actualiza ese mismo Excel." />
                    <RadioButton x:Name="CrearNuevoOption"
                                 Content="Crear uno nuevo"
                                 FontWeight="SemiBold" />
                    <TextBlock Margin="24,4,0,0" Foreground="#5D7287" Text="Si el nombre ya existe, se crea una copia nueva con numeracion automatica." />
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="5" Margin="0,20,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Cancelar" Click="CancelarButton_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Exportar" Click="AceptarButton_Click" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
