{
  "catalog_patch": {
    "version": "car_catalog_api_v1_patch_2026-02-03_aliases_search_v1",
    "applies_to_schema": "car_catalog_api_v1",
    "notes": {
      "scope": "Argentina",
      "description": "Aliases y normalizaciones para mejorar búsqueda/SEO y evitar duplicados por escritura. No cambia IDs; solo agrega 'aliases' por modelo y reglas de normalización de query."
    },
    "rules": {
      "query_normalization": {
        "lowercase": true,
        "trim": true,
        "collapse_spaces": true,
        "remove_diacritics": true,
        "replace": [
          { "from": "cr v", "to": "cr-v" },
          { "from": "crv", "to": "cr-v" },
          { "from": "hr v", "to": "hr-v" },
          { "from": "hrv", "to": "hr-v" },
          { "from": "mercedes", "to": "mercedes-benz" },
          { "from": "vw", "to": "volkswagen" }
        ]
      },
      "alias_rules": {
        "allow_common_trim_in_alias": true,
        "allow_punctuation_variants": true,
        "avoid_years_in_alias": true
      }
    },
    "overrides": {
