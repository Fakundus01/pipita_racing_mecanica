{
  "_file": "api_vehiculos.patch.taxonomy.v3.json",
  "catalog_patch": {
    "version": "car_catalog_api_v1_patch_2026-02-03_taxonomy_v3_full_base_coverage",
    "applies_to_schema": "api_vehiculos_base_v0",
    "notes": {
      "scope": "Argentina",
      "description": "Normaliza taxonomía para TODO el base actual (58 marcas) agregando campos body/segment/attributes por modelo, sin tocar el array segments original. Match por nombre exacto dentro de cada brand_id.",
      "compat": "Diseñado para tu base actual (brand.brand_id + model.name + model.segments)."
    },
    "operation": "normalize_taxonomy_fields",
    "rules": {
      "match_strategy": "brand_id + model.name (case-sensitive) -> set fields",
      "attributes_enum": [
        "ev",
        "hybrid",
        "phev",
        "commercial",
        "crossover",
        "sports",
        "luxury",
        "ultra_luxury",
        "supercar",
        "hypercar"
      ],
      "body_enum": ["Car", "SUV", "Truck", "Van", "MPV"],
      "segment_enum": ["Hatchback", "Sedan", "Coupe", "Pickup", null],
      "derivation_reference": {
        "body": "SUV|Truck|Van|MPV if present in segments else Car",
        "segment": "Pickup/Hatchback/Sedan/Coupe if present in segments else null",
        "attributes": "Map EV->ev, Commercial->commercial, Crossover->crossover, Sports->sports, Luxury->luxury, Ultra Luxury->ultra_luxury, Supercar->supercar, Hypercar->hypercar"
      }
    },
